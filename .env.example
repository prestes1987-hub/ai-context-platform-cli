# --- LLM (sem configuração = LLM extrativo local, 100% offline) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
# Servidor local compatível com a API da OpenAI (Ollama, vLLM, llama.cpp), por exemplo
# servindo o modelo fine-tunado do projeto corporate-knowledge-finetune-cli:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=lumora-assistente
# OFFLINE=true

# --- Embeddings (sem chave = embedder local por hashing) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Persistência (conhecimento + memória + auditoria no mesmo SQLite) ---
DB_FILE=data/platform.db
KB_DIR=knowledge-base
USERS_FILE=data/users.json

# --- Conhecimento (RAG híbrido) ---
SIMILARITY_THRESHOLD=0.36
TOP_K=3
VECTOR_WEIGHT=0.5

# --- Contexto e memória ---
CONTEXT_TOKEN_BUDGET=2200
HISTORY_TOKEN_BUDGET=500
MEMORY_TOKEN_BUDGET=250
MEMORY_MAX_ITEMS=5

DEBUG=false
